# Mashq environment variables
# Copy this to .env.local and fill in real values.
# See README.md for setup instructions.

# App
APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3100

# Database (Neon)
DATABASE_URL=

# Auth (Better Auth)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3100

# LLM: primary provider
ANTHROPIC_API_KEY=

# LLM: secondary provider
GOOGLE_GENERATIVE_AI_API_KEY=

# Voice: STT
SONIOX_API_KEY=

# Voice: TTS (Uplift)
UPLIFT_API_KEY=

# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Observability
SENTRY_DSN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASEURL=https://cloud.langfuse.com

# Server secrets (32+ random bytes each)
HEALTH_TOKEN=
PSEUDONYM_SECRET=
SPEECH_SIGNING_SECRET=
CANARY_TOKEN=

# Cron secret (Vercel)
CRON_SECRET=

# Demo accounts (seeded by pnpm db:seed)
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_MANAGER_EMAIL=
DEMO_MANAGER_PASSWORD=
DEMO_LEARNER_EMAIL=
DEMO_LEARNER_PASSWORD=
DEMO_LEARNER2_EMAIL=
DEMO_LEARNER2_PASSWORD=
SMOKE_EMAIL=
SMOKE_PASSWORD=

